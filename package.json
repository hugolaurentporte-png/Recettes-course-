{
  "name": "recettes-courses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build && node scripts/gen-sw.mjs",
    "start": "npx --yes serve@14.2.4 out -l 3000",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:recipes": "vitest run tests/catalog.test.ts",
    "test:e2e": "node e2e/parcours.cjs",
    "import:recipes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/import-recipes.ts"
  },
  "dependencies": {
    "idb": "8.0.4",
    "next": "15.5.29",
    "pdfjs-dist": "6.4.299",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.2.2",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "5.1.0"
  }
}
